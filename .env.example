# REQUIRED: generate a long random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Only used once to create config/admin.json. After that, change the owner login in config/admin.json (hot-reload).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
# Shared secret for trusted donation ingestion integration. Keep private.
DONATION_INGEST_TOKEN=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
PORT=3000
# Bind to localhost behind Caddy/reverse proxy by default.
HOST=127.0.0.1
DATA_DIR=./data
# Set true only behind a trusted HTTPS reverse proxy (Caddy recommended).
TRUST_PROXY=false

# SOOP 앱 (게임 내 /숲로그인). SOOP 앱 Redirect URL = PUBLIC_BASE_URL + /oauth/callback
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
# 인증 도메인(PUBLIC_BASE_URL)은 config/central.json의 publicBaseUrl에서 설정합니다 (재시작 없이 반영).
